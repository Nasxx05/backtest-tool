# =============================================================
# Backtest Tool - Environment Variables Template
# =============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================

# --- Database Configuration ---
# PostgreSQL connection details
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=backtest_tool
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password_here

# --- Flask Configuration ---
# Secret key for session security (generate a random string)
# You can generate one with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-a-random-string
FLASK_ENV=development
FLASK_DEBUG=1

# --- Server Configuration ---
BACKEND_PORT=5000
FRONTEND_PORT=3000

# --- CORS Configuration ---
# Which URLs are allowed to call our API
CORS_ORIGINS=http://localhost:3000
